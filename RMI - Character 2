package javaapplication6;
import RMI.CharacterService;
import java.net.URI;
import java.rmi.registry.*;
import java.util.*;


public class JavaApplication6 {

    public static void main(String[] args) throws Exception{
        String studentCode = "B23DCCN932";
        String qcode = "U5ArQl8s";
        
        Registry registry = LocateRegistry.getRegistry("36.50.135.242", 1099);
        CharacterService service = (CharacterService) registry.lookup("RMICharacterService");
        String data = service.requestCharacter(studentCode, qcode);
        int number = Integer.parseInt(data.trim());


        // 3. Chuyển số thập phân sang số La Mã
        int[] values = {
            1000, 900, 500, 400, 100, 90, 50,
            40, 10, 9, 5, 4, 1
        };

        String[] roman = {
            "M", "CM", "D", "CD", "C", "XC", "L",
            "XL", "X", "IX", "V", "IV", "I"
        };

        String result = "";

        for (int i = 0; i < values.length; i++) {

            while (number >= values[i]) {
                result += roman[i];
                number -= values[i];
            }
        }
        service.submitCharacter(studentCode, qcode, result);
    }
    
}
